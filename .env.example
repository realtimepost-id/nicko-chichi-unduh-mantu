# Salin file ini menjadi .env (lokal) dan isi di Vercel → Settings → Environment Variables.
# JANGAN commit file .env ke GitHub.

# Dari console.upstash.com → database Redis proyek INI → tab "REST API"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password admin. Disarankan memakai hash:  npm run hash-password -- "PasswordKuat123"
ADMIN_PASSWORD_HASH=
# (alternatif sederhana, kurang disarankan) ADMIN_PASSWORD=

# Teks acak minimal 32 karakter untuk menandatangani sesi admin. Buat dengan:  openssl rand -hex 32
SESSION_SECRET=

# Disarankan (WAJIB bila memakai domain sendiri): URL lengkap tanpa garis miring di akhir.
# Dipakai untuk gambar preview WhatsApp (og:image) dan og:url.
# SITE_URL=https://nicko-chichi.example.com
